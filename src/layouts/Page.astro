---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import type { Language } from "../i18n";
import "@fontsource/shippori-mincho/400.css";
import "@fontsource/shippori-mincho/700.css";
import "../styles/site.css";
interface Props { title: string; lang?: Language; slug?: string }
const { title, lang = "en", slug } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {slug && <>
      <link rel="canonical" href={getAbsoluteLocaleUrl(lang, `${slug}/`)} />
      <link rel="alternate" hreflang="en" href={getAbsoluteLocaleUrl("en", `${slug}/`)} />
      <link rel="alternate" hreflang="ja" href={getAbsoluteLocaleUrl("ja", `${slug}/`)} />
    </>}
  </head>
  <body><main><slot name="header" /><slot /></main></body>
</html>
