---
import type { CollectionEntry } from "astro:content";
import { messages, type Language } from "../../i18n";
interface Props {
  lang: Language;
  data: Extract<CollectionEntry<"extensions">["data"], { pattern: "user-configured" }>;
}
const { lang, data } = Astro.props;
const copy = messages[lang];
---
<p>{copy.patterns.userConfigured}</p>
{data.hosts && <p>{copy.destinationsHeading}: <code>{data.hosts.join(", ")}</code></p>}
{data.requests && <p>{data.requests[lang]}</p>}
