---
import type { CollectionEntry } from "astro:content";
import { messages, type Language } from "../i18n";
import InterpolatedText from "./InterpolatedText.astro";
interface Props { lang: Language; data: CollectionEntry<"extensions">["data"] }
const { lang, data } = Astro.props;
const copy = messages[lang];
const date = new Intl.DateTimeFormat(copy.locale, { dateStyle: "long", timeZone: "UTC" }).format(new Date(`${data.updated}T00:00:00Z`));
---
<section lang={lang} aria-labelledby={`policy-${lang}`}>
  <p><small><InterpolatedText text={copy.updated}><time slot="date" datetime={data.updated}>{date}</time></InterpolatedText></small></p>
  {data.unofficial && <p>{data.unofficialNote?.[lang]}</p>}
  <h2>{copy.dataHeading}</h2>
  {data.storedData && data.storedData.length > 0 && <ul>{data.storedData.map((item) => <li>{item[lang]}</li>)}</ul>}
  <p>{copy.patterns[data.pattern]}</p>
  {data.pattern === "user-configured" && <>
    {data.hosts && <p>{copy.destinationsHeading}: <code>{data.hosts.join(", ")}</code></p>}
    {data.requests && <p>{data.requests[lang]}</p>}
  </>}
  <h2>{copy.removalHeading}</h2>
  <p>{data.removal[lang]}</p>
  <slot />
</section>
<footer>
  <p>{copy.disclaimer}<br /><InterpolatedText text={copy.contact}><a slot="email" href="mailto:contact@simochee.net">contact@simochee.net</a></InterpolatedText></p>
</footer>
